# Modelo de variáveis do docker-compose.yml. Copie para .env (não versionado).
# Todos os valores abaixo são exemplos fictícios: troque antes de expor o sistema.

# Banco
DB_NAME=flux
DB_USERNAME=flux
DB_PASSWORD=troque-esta-senha-do-banco

# Segredo do JWT: no mínimo 32 bytes. Gere com: openssl rand -base64 48
JWT_SEGREDO=troque-este-segredo-por-um-valor-aleatorio-de-48-bytes

# Cookie de renovação com o atributo Secure.
# true em produção (HTTPS). false só para testar o compose em http://localhost.
COOKIE_SEGURO=false

# Usuário inicial: criado na primeira subida, se o e-mail ainda não existir.
USUARIO_INICIAL_EMAIL=dono@flux.local
USUARIO_INICIAL_SENHA=troque-esta-senha
USUARIO_INICIAL_NOME=Dono

# Porta do nginx no host
WEB_PORTA=80
