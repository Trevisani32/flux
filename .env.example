# Modelo de variáveis do docker-compose.yml. Copie para .env (não versionado).
# Todos os valores abaixo são exemplos fictícios: troque antes de expor o sistema.

# Banco
DB_NAME=flux
DB_USERNAME=flux
DB_PASSWORD=troque-esta-senha-do-banco

# Segredo do JWT: no mínimo 32 bytes. Gere com: openssl rand -base64 48
JWT_SEGREDO=troque-este-segredo-por-um-valor-aleatorio-de-48-bytes

# Cookie de renovação com o atributo Secure.
# true em produção (HTTPS). false só para testar o compose em http://localhost.
COOKIE_SEGURO=false

# Usuário inicial: criado na primeira subida, já com o e-mail confirmado, se o e-mail ainda não existir.
USUARIO_INICIAL_EMAIL=dono@flux.local
USUARIO_INICIAL_SENHA=troque-esta-senha
USUARIO_INICIAL_NOME=Dono

# Endereço público da web, sem barra no fim. Vai nos links dos e-mails.
APP_URL_BASE=http://localhost

# Cadastro público. Com true, APP_CONTROLADOR_NOME e APP_CONTROLADOR_EMAIL são obrigatórios.
APP_CADASTRO_PUBLICO=false
# Responsável pelos dados desta instância (aparece nos termos e na política de privacidade).
APP_CONTROLADOR_NOME=
APP_CONTROLADOR_EMAIL=

# E-mail (SMTP). O remetente aparece como "Flux <APP_EMAIL_REMETENTE>".
# Os valores abaixo são fictícios: sem um SMTP de verdade, os e-mails ficam pendentes
# e são reenviados a cada 5 minutos. O docker-compose.e2e.yml troca tudo pelo Mailpit.
APP_EMAIL_REMETENTE=nao-responda@exemplo.local
MAIL_HOST=smtp.exemplo.local
MAIL_PORTA=587
MAIL_USUARIO=nao-responda@exemplo.local
MAIL_SENHA=troque-esta-senha-do-smtp
MAIL_AUTENTICACAO=true
MAIL_STARTTLS=true

# Porta do nginx no host
WEB_PORTA=80
